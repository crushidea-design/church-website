{
  "hosting": [
    {
      "target": "church",
      "public": "dist/hosting/church",
      "ignore": [
        "firebase.hosting.json",
        "**/.*",
        "**/node_modules/**",
        "_redirects",
        "_headers"
      ],
      "predeploy": [
        "npm run build:hosting"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/.netlify/functions/raah-calendar-callback",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/.netlify/functions/raah-calendar-callback",
          "function": {
            "functionId": "raahApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/raah/**",
          "function": {
            "functionId": "raahApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "siteApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/next",
          "destination": "/next.html"
        },
        {
          "source": "/next/**",
          "destination": "/next.html"
        },
        {
          "source": "/next-generation/**",
          "destination": "/next.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "redirects": [
        {
          "source": "/next-generation",
          "destination": "/next",
          "type": 301
        }
      ]
    },
    {
      "target": "raah",
      "public": "dist/hosting/raah",
      "ignore": [
        "firebase.hosting.json",
        "**/.*",
        "**/node_modules/**",
        "_redirects",
        "_headers"
      ],
      "predeploy": [
        "npm run build:hosting"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/api/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        },
        {
          "source": "/.netlify/functions/raah-calendar-callback",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/.netlify/functions/raah-calendar-callback",
          "function": {
            "functionId": "raahApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/raah/**",
          "function": {
            "functionId": "raahApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "siteApi",
            "region": "asia-northeast1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
