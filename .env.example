# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: Optional. Model for word-fruit AI (default gemini-3.8-flash). Set gemini-2.5-flash to roll back.
GEMINI_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL="your-supabase-url"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_URL="your-supabase-url"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
RAAH_ENCRYPTION_SECRET="generate-a-long-random-secret"
# "true" requires an active row in raah_workspace_access for every RAAH API call.
# Register the pastoral worker first (docs/2026-09-28-raah-access-rollout.md).
RAAH_ACCESS_ENFORCED="false"
# "true" exposes /api/raah/communion/* (grant required regardless of the flag above).
RAAH_COMMUNION_ENABLED="false"

# RAAH Google Calendar Integration
GOOGLE_CALENDAR_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CALENDAR_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_CALENDAR_ID="your-raah-dedicated-calendar-id"

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_KEY=
VITE_FIREBASE_API_KEY="your-firebase-api-key"

# Local scheduled notifications are disabled by default. Enable only against a test project.
ENABLE_LOCAL_SCHEDULED_NOTIFICATIONS=false
